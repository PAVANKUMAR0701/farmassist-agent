# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Bearer token clients must send as "Authorization: Bearer <token>". At least 32 characters.
# Generate a cryptographically random one:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
FARMASSIST_API_TOKEN=

# The single demo farm this token can read and write.
FARMASSIST_DEMO_FARM_ID=demo-farm

# Browser origins allowed to call the server (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173

# Optional: use a real DynamoDB table instead of in-memory storage.
# FARMASSIST_TABLE_NAME=
# AWS_PROFILE=MyPersonalAWSAccount
# AWS_REGION=ap-south-1

# Optional: Bedrock narration for weekly_insights. Without BEDROCK_MODEL_ID the tool uses template text.
# BEDROCK_MODEL_ID=in.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_REGION=ap-south-1
# Named AWS profile used only for Bedrock calls (e.g. keys from another account):
# BEDROCK_AWS_PROFILE=farmassist-bedrock

# Agent (npm run agent). MCP endpoint to talk to, and an optional Bedrock model for chat.
# Without AGENT_MODEL_ID the agent uses its deterministic command parser. See docs/bedrock-access.md.
# FARMASSIST_MCP_URL=http://127.0.0.1:3000/mcp
# AGENT_MODEL_ID=apac.amazon.nova-lite-v1:0
