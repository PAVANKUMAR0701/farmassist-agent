# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Bearer token clients must send as "Authorization: Bearer <token>". At least 32 characters.
# Generate a cryptographically random one:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
FARMASSIST_API_TOKEN=

# The single demo farm this token can read and write.
FARMASSIST_DEMO_FARM_ID=demo-farm

# Browser origins allowed to call the server (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173

# Optional: use a real DynamoDB table instead of in-memory storage.
# FARMASSIST_TABLE_NAME=
# AWS_PROFILE=MyPersonalAWSAccount
# AWS_REGION=ap-south-1
