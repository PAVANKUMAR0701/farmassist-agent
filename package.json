{
  "name": "farmassist-agent",
  "version": "0.1.0",
  "description": "Talk to your farm ledger — every number verified, never guessed. A self-hosted MCP server (Streamable HTTP) on AWS Lambda + DynamoDB + Amazon Bedrock.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "tsx watch scripts/local-server.ts",
    "start:local": "tsx scripts/local-server.ts",
    "smoke": "tsx scripts/protocol-smoke.ts",
    "live-hardening": "tsx scripts/live-hardening.ts",
    "agent": "tsx scripts/agent-cli.ts",
    "agent-eval": "tsx scripts/agent-eval.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:lambda": "esbuild src/lambda/handler.ts --bundle --platform=node --target=node22 --format=esm --out-extension:.js=.mjs --sourcemap --outdir=dist \"--banner:js=import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "build:web": "tsx scripts/build-web.ts",
    "pretypecheck": "npm run build:web --silent",
    "pretest": "npm run build:web --silent",
    "start:chat": "tsx scripts/local-chat-server.ts",
    "farm-scenario": "tsx scripts/farm-scenario.ts",
    "narration-eval": "tsx scripts/narration-eval.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1151.0",
    "@aws-sdk/client-dynamodb": "3.1151.0",
    "@aws-sdk/client-ssm": "3.1151.0",
    "@aws-sdk/credential-providers": "3.1151.0",
    "@aws-sdk/lib-dynamodb": "3.1151.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "aws-jwt-verify": "5.2.1",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "@types/node": "22.20.5",
    "aws-sdk-client-mock": "4.1.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
